<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Topluluk &amp; Arkadaşlar"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_dark"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnFacebookAdd"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="Facebook ile Arkadaş Bul"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:icon="@drawable/ic_user"
        app:iconTint="@android:color/white"
        android:backgroundTint="#1877F2" />

    <!-- Friend 1 Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/glass_white_5"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/glass_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="M"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/rounded_background_glass"
                android:textColor="@color/primary_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mert Can"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Az önce göğüs antrenmanını tamamladı! 💪"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👏"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/glass_border"
                android:minWidth="0dp"
                android:padding="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Friend 2 Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/glass_white_5"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/glass_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="A"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/rounded_background_glass"
                android:textColor="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayşe Yılmaz"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10.000 adım hedefine ulaştı! 👟"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary_dark"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/glass_border"
                android:minWidth="0dp"
                android:padding="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Leaderboard Button -->
    <Button
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🏆 Haftalık Liderlik Tablosu"
        android:textColor="@color/text_primary_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@android:drawable/btn_star_big_on"
        app:iconTint="@color/accent"
        android:backgroundTint="@color/glass_white_10"
        android:layout_marginTop="24dp" />

</LinearLayout>


